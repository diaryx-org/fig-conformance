{"id":"x.j: replace with float","op":"replaceValue","args":[["x","j"],2.5],"expect":{"ok":true,"splice":[23,23,".5"]}},
{"id":"x.j: replace with bool","op":"replaceValue","args":[["x","j"],true],"expect":{"ok":true,"splice":[22,23,"true"]}},
{"id":"x.j: replace with word","op":"replaceValue","args":[["x","j"],"word"],"expect":{"ok":true,"splice":[22,23,"\"word\""]}},
{"id":"x.j: replace with spaced","op":"replaceValue","args":[["x","j"],"two words"],"expect":{"ok":true,"splice":[22,23,"\"two words\""]}},
{"id":"x.j: replace with punctuated","op":"replaceValue","args":[["x","j"],"a: b # c, [d] {e} \"f\" 'g'"],"expect":{"ok":true,"splice":[22,23,"\"a: b # c, [d] {e} \\\"f\\\" 'g'\""]}},
{"id":"x.j: replace with multiline","op":"replaceValue","args":[["x","j"],"line one\nline two"],"expect":{"ok":true,"splice":[22,23,"\"line one\\nline two\""]}},
{"id":"x.j: replace with empty","op":"replaceValue","args":[["x","j"],""],"expect":{"ok":true,"splice":[22,23,"\"\""]}},
{"id":"x.j: replace with map","op":"replaceValue","args":[["x","j"],{"x":1,"y":"two"}],"expect":{"ok":true,"splice":[22,23,"{ x = 1, y = \"two\" }"]}},
{"id":"x.j: replace with list","op":"replaceValue","args":[["x","j"],["a","b"]],"expect":{"ok":true,"splice":[22,23,"[\"a\", \"b\"]"]}},
{"id":"x.j: replace with nested","op":"replaceValue","args":[["x","j"],{"inner":{"deep":[1,2]}}],"expect":{"ok":true,"splice":[22,23,"{ inner = { deep = [1, 2] } }"]}},
{"id":"x.j: replace with empty-map","op":"replaceValue","args":[["x","j"],{}],"expect":{"ok":true,"splice":[22,23,"{}"]}},
{"id":"x.j: replace with empty-list","op":"replaceValue","args":[["x","j"],[]],"expect":{"ok":true,"splice":[22,23,"[]"]}},
{"id":"x.j: add leading comment","op":"addLeadingComment","args":[["x","j"],"added comment"],"expect":{"ok":true,"splice":[18,18,"# added comment\n"]}},
{"id":"x.j: set trailing comment","op":"setTrailingComment","args":[["x","j"],"added comment"],"expect":{"ok":true,"splice":[23,23," # added comment"]}}
]}
