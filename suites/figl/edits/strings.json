{"id":"yes: replace with multiline","op":"replaceValue","args":[["yes"],"line one\nline two"],"expect":{"ok":true,"splice":[189,192,"'''\nline one\nline two\n'''"]}},
{"id":"yes: replace with empty","op":"replaceValue","args":[["yes"],""],"expect":{"ok":true,"splice":[189,192,"''"]}},
{"id":"yes: replace with map","op":"replaceValue","args":[["yes"],{"x":1,"y":"two"}],"expect":{"ok":true,"splice":[189,192,"{x=1 y=two}"]}},
{"id":"yes: replace with list","op":"replaceValue","args":[["yes"],["a","b"]],"expect":{"ok":true,"splice":[189,192,"[a, b]"]}},
{"id":"yes: replace with nested","op":"replaceValue","args":[["yes"],{"inner":{"deep":[1,2]}}],"expect":{"ok":true,"splice":[189,192,"{inner={deep=[1, 2]}}"]}},
{"id":"yes: replace with empty-map","op":"replaceValue","args":[["yes"],{}],"expect":{"ok":true,"splice":[189,192,"{}"]}},
{"id":"yes: replace with empty-list","op":"replaceValue","args":[["yes"],[]],"expect":{"ok":true,"splice":[189,192,"[]"]}},
{"id":"yes: add leading comment","op":"addLeadingComment","args":[["yes"],"added comment"],"expect":{"ok":true,"splice":[183,183,"# added comment\n"]}},
{"id":"yes: set trailing comment","op":"setTrailingComment","args":[["yes"],"added comment"],"expect":{"ok":true,"splice":[192,192," # added comment"]}}
