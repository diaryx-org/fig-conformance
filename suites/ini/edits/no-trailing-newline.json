{"source": "no-trailing-newline.ini", "cases": [
{"id":"root: insert int","op":"insertValue","args":[[],"added_int",42],"expect":{"ok":true,"splice":[5,5,"\nadded_int = 42\n"]}},
{"id":"root: insert negative","op":"insertValue","args":[[],"added_negative",-7],"expect":{"ok":true,"splice":[5,5,"\nadded_negative = -7\n"]}},
{"id":"root: insert float","op":"insertValue","args":[[],"added_float",2.5],"expect":{"ok":true,"splice":[5,5,"\nadded_float = 2.5\n"]}},
{"id":"root: insert bool","op":"insertValue","args":[[],"added_bool",true],"expect":{"ok":true,"splice":[5,5,"\nadded_bool = true\n"]}},
{"id":"root: insert word","op":"insertValue","args":[[],"added_word","word"],"expect":{"ok":true,"splice":[5,5,"\nadded_word = word\n"]}},
{"id":"root: insert map","op":"insertValue","args":[[],"added_map",{"x":1,"y":"two"}],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: insert list","op":"insertValue","args":[[],"added_list",["a","b"]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: insert nested","op":"insertValue","args":[[],"added_nested",{"inner":{"deep":[1,2]}}],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: insert empty-map","op":"insertValue","args":[[],"added_empty-map",{}],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: insert empty-list","op":"insertValue","args":[[],"added_empty-list",[]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: set new key","op":"setValue","args":[["set_key"],"set"],"expect":{"ok":true,"splice":[5,5,"\nset_key = set\n"]}},
{"id":"root: set existing key","op":"setValue","args":[["x"],"set"],"expect":{"ok":true,"splice":[4,5,"set"]}},
{"id":"root: add dangling comment","op":"addDanglingComment","args":[[],"added comment"],"expect":{"ok":true,"splice":[5,5,"\n; added comment\n"]}},
{"id":"x: rename","op":"renameKey","args":[["x"],"renamed"],"expect":{"ok":true,"splice":[0,1,"renamed"]}},
{"id":"x: delete","op":"deleteKey","args":[["x"]],"expect":{"ok":true,"splice":[0,5,""]}},
{"id":"x: replace with int","op":"replaceValue","args":[["x"],42],"expect":{"ok":true,"splice":[4,5,"42"]}},
{"id":"x: replace with negative","op":"replaceValue","args":[["x"],-7],"expect":{"ok":true,"splice":[4,5,"-7"]}},
{"id":"x: replace with float","op":"replaceValue","args":[["x"],2.5],"expect":{"ok":true,"splice":[4,5,"2.5"]}},
{"id":"x: replace with bool","op":"replaceValue","args":[["x"],true],"expect":{"ok":true,"splice":[4,5,"true"]}},
{"id":"x: replace with word","op":"replaceValue","args":[["x"],"word"],"expect":{"ok":true,"splice":[4,5,"word"]}},
{"id":"x: replace with spaced","op":"replaceValue","args":[["x"],"two words"],"expect":{"ok":true,"splice":[4,5,"two words"]}},
{"id":"x: replace with punctuated","op":"replaceValue","args":[["x"],"a: b # c, [d] {e} \"f\" 'g'"],"expect":{"ok":true,"splice":[4,5,"a: b # c, [d] {e} \"f\" 'g'"]}},
{"id":"x: replace with multiline","op":"replaceValue","args":[["x"],"line one\nline two"],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"x: replace with empty","op":"replaceValue","args":[["x"],""],"expect":{"ok":true,"splice":[4,5,"\"\""]}},
{"id":"x: replace with map","op":"replaceValue","args":[["x"],{"x":1,"y":"two"}],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"x: replace with list","op":"replaceValue","args":[["x"],["a","b"]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"x: replace with nested","op":"replaceValue","args":[["x"],{"inner":{"deep":[1,2]}}],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"x: replace with empty-map","op":"replaceValue","args":[["x"],{}],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"x: replace with empty-list","op":"replaceValue","args":[["x"],[]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"x: add leading comment","op":"addLeadingComment","args":[["x"],"added comment"],"expect":{"ok":true,"splice":[0,0,"; added comment\n"]}},
{"id":"x: set trailing comment","op":"setTrailingComment","args":[["x"],"added comment"],"expect":{"ok":false,"status":"UnsupportedFormat"}}
