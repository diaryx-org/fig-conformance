{"source": "no-trailing-newline.properties", "cases": [
{"id":"root: insert int","op":"insertValue","args":[[],"added_int",42],"expect":{"ok":true,"splice":[7,7,"\nadded_int=42\n"]}},
{"id":"root: insert negative","op":"insertValue","args":[[],"added_negative",-7],"expect":{"ok":true,"splice":[7,7,"\nadded_negative=-7\n"]}},
{"id":"root: insert float","op":"insertValue","args":[[],"added_float",2.5],"expect":{"ok":true,"splice":[7,7,"\nadded_float=2.5\n"]}},
{"id":"root: insert bool","op":"insertValue","args":[[],"added_bool",true],"expect":{"ok":true,"splice":[7,7,"\nadded_bool=true\n"]}},
{"id":"root: insert word","op":"insertValue","args":[[],"added_word","word"],"expect":{"ok":true,"splice":[7,7,"\nadded_word=word\n"]}},
{"id":"root: insert map","op":"insertValue","args":[[],"added_map",{"x":1,"y":"two"}],"expect":{"ok":true,"splice":[7,7,"\nadded_map:\n  x=1\n  y=two\n"]}},
{"id":"root: insert list","op":"insertValue","args":[[],"added_list",["a","b"]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: insert nested","op":"insertValue","args":[[],"added_nested",{"inner":{"deep":[1,2]}}],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: insert empty-map","op":"insertValue","args":[[],"added_empty-map",{}],"expect":{"ok":true,"splice":[7,7,"\nadded_empty-map=\n"]}},
{"id":"root: insert empty-list","op":"insertValue","args":[[],"added_empty-list",[]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: set new key","op":"setValue","args":[["set_key"],"set"],"expect":{"ok":true,"splice":[7,7,"\nset_key=set\n"]}},
{"id":"root: set existing key","op":"setValue","args":[["a"],"set"],"expect":{"ok":true,"splice":[2,3,"set"]}},
{"id":"root: reorder keys reversed","op":"reorderKeys","args":[[],["b","a"]],"expect":{"ok":true,"splice":[0,7,"b=2\na=1\n"]}},
{"id":"root: move last key first","op":"moveKey","args":[["b"],["a"]],"expect":{"ok":true,"splice":[0,7,"b=2\na=1\n"]}},
{"id":"root: add dangling comment","op":"addDanglingComment","args":[[],"added comment"],"expect":{"ok":true,"splice":[7,7,"\n# added comment\n"]}},
{"id":"a: rename","op":"renameKey","args":[["a"],"renamed"],"expect":{"ok":true,"splice":[0,1,"renamed"]}},
{"id":"a: delete","op":"deleteKey","args":[["a"]],"expect":{"ok":true,"splice":[0,4,""]}},
{"id":"a: replace with int","op":"replaceValue","args":[["a"],42],"expect":{"ok":true,"splice":[2,3,"42"]}},
{"id":"a: replace with negative","op":"replaceValue","args":[["a"],-7],"expect":{"ok":true,"splice":[2,3,"-7"]}},
{"id":"a: replace with float","op":"replaceValue","args":[["a"],2.5],"expect":{"ok":true,"splice":[2,3,"2.5"]}},
{"id":"a: replace with bool","op":"replaceValue","args":[["a"],true],"expect":{"ok":true,"splice":[2,3,"true"]}},
{"id":"a: replace with word","op":"replaceValue","args":[["a"],"word"],"expect":{"ok":true,"splice":[2,3,"word"]}},
{"id":"a: replace with spaced","op":"replaceValue","args":[["a"],"two words"],"expect":{"ok":true,"splice":[2,3,"two words"]}},
{"id":"a: replace with punctuated","op":"replaceValue","args":[["a"],"a: b # c, [d] {e} \"f\" 'g'"],"expect":{"ok":true,"splice":[2,3,"a: b # c, [d] {e} \"f\" 'g'"]}},
{"id":"a: replace with multiline","op":"replaceValue","args":[["a"],"line one\nline two"],"expect":{"ok":true,"splice":[2,3,"line one\\nline two"]}},
{"id":"a: replace with empty","op":"replaceValue","args":[["a"],""],"expect":{"ok":true,"splice":[2,3,""]}},
