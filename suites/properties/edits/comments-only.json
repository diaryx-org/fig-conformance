{"source": "comments-only.properties", "cases": [
{"id":"root: insert int","op":"insertValue","args":[[],"added_int",42],"expect":{"ok":true,"splice":[18,18,"\nadded_int=42\n"]}},
{"id":"root: insert negative","op":"insertValue","args":[[],"added_negative",-7],"expect":{"ok":true,"splice":[18,18,"\nadded_negative=-7\n"]}},
{"id":"root: insert float","op":"insertValue","args":[[],"added_float",2.5],"expect":{"ok":true,"splice":[18,18,"\nadded_float=2.5\n"]}},
{"id":"root: insert bool","op":"insertValue","args":[[],"added_bool",true],"expect":{"ok":true,"splice":[18,18,"\nadded_bool=true\n"]}},
{"id":"root: insert word","op":"insertValue","args":[[],"added_word","word"],"expect":{"ok":true,"splice":[18,18,"\nadded_word=word\n"]}},
{"id":"root: insert map","op":"insertValue","args":[[],"added_map",{"x":1,"y":"two"}],"expect":{"ok":true,"splice":[18,18,"\nadded_map:\n  x=1\n  y=two\n"]}},
{"id":"root: insert list","op":"insertValue","args":[[],"added_list",["a","b"]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: insert nested","op":"insertValue","args":[[],"added_nested",{"inner":{"deep":[1,2]}}],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: insert empty-map","op":"insertValue","args":[[],"added_empty-map",{}],"expect":{"ok":true,"splice":[18,18,"\nadded_empty-map=\n"]}},
{"id":"root: insert empty-list","op":"insertValue","args":[[],"added_empty-list",[]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: set new key","op":"setValue","args":[["set_key"],"set"],"expect":{"ok":true,"splice":[18,18,"\nset_key=set\n"]}},
{"id":"root: add dangling comment","op":"addDanglingComment","args":[[],"added comment"],"expect":{"ok":true,"splice":[18,18,"\n# added comment\n"]}}
]}
