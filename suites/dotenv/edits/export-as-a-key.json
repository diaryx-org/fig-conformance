{"source": "export-as-a-key.env", "cases": [
{"id":"root: insert int","op":"insertValue","args":[[],"added_int",42],"expect":{"ok":true,"splice":[9,9,"added_int=42\n"]}},
{"id":"root: insert negative","op":"insertValue","args":[[],"added_negative",-7],"expect":{"ok":true,"splice":[9,9,"added_negative=-7\n"]}},
{"id":"root: insert float","op":"insertValue","args":[[],"added_float",2.5],"expect":{"ok":true,"splice":[9,9,"added_float=2.5\n"]}},
{"id":"root: insert bool","op":"insertValue","args":[[],"added_bool",true],"expect":{"ok":true,"splice":[9,9,"added_bool=true\n"]}},
{"id":"root: insert word","op":"insertValue","args":[[],"added_word","word"],"expect":{"ok":true,"splice":[9,9,"added_word=word\n"]}},
{"id":"root: insert map","op":"insertValue","args":[[],"added_map",{"x":1,"y":"two"}],"expect":{"ok":false,"status":"ParseError"}},
{"id":"root: insert list","op":"insertValue","args":[[],"added_list",["a","b"]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: insert nested","op":"insertValue","args":[[],"added_nested",{"inner":{"deep":[1,2]}}],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: insert empty-map","op":"insertValue","args":[[],"added_empty-map",{}],"expect":{"ok":false,"status":"ParseError"}},
{"id":"root: insert empty-list","op":"insertValue","args":[[],"added_empty-list",[]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: set new key","op":"setValue","args":[["set_key"],"set"],"expect":{"ok":true,"splice":[9,9,"set_key=set\n"]}},
{"id":"root: set existing key","op":"setValue","args":[["export"],"set"],"expect":{"ok":true,"splice":[23,24,"set"]}},
{"id":"root: add dangling comment","op":"addDanglingComment","args":[[],"added comment"],"expect":{"ok":true,"splice":[9,9,"# added comment\n"]}},
{"id":"export: rename","op":"renameKey","args":[["export"],"renamed"],"expect":{"ok":true,"splice":[0,22,"renamed=1\nexport renamed"]}},
{"id":"export: delete","op":"deleteKey","args":[["export"]],"expect":{"ok":true,"splice":[0,25,""]}},
{"id":"export: replace with int","op":"replaceValue","args":[["export"],42],"expect":{"ok":true,"splice":[23,23,"4"]}},
{"id":"export: replace with negative","op":"replaceValue","args":[["export"],-7],"expect":{"ok":true,"splice":[23,24,"-7"]}},
{"id":"export: replace with float","op":"replaceValue","args":[["export"],2.5],"expect":{"ok":true,"splice":[24,24,".5"]}},
{"id":"export: replace with bool","op":"replaceValue","args":[["export"],true],"expect":{"ok":true,"splice":[23,24,"true"]}},
{"id":"export: replace with word","op":"replaceValue","args":[["export"],"word"],"expect":{"ok":true,"splice":[23,24,"word"]}},
{"id":"export: replace with spaced","op":"replaceValue","args":[["export"],"two words"],"expect":{"ok":true,"splice":[23,24,"two words"]}},
{"id":"export: replace with punctuated","op":"replaceValue","args":[["export"],"a: b # c, [d] {e} \"f\" 'g'"],"expect":{"ok":true,"splice":[23,24,"\"a: b # c, [d] {e} \\\"f\\\" 'g'\""]}},
{"id":"export: replace with multiline","op":"replaceValue","args":[["export"],"line one\nline two"],"expect":{"ok":true,"splice":[23,24,"\"line one\\nline two\""]}},
{"id":"export: replace with empty","op":"replaceValue","args":[["export"],""],"expect":{"ok":true,"splice":[23,24,""]}},
{"id":"export: replace with map","op":"replaceValue","args":[["export"],{"x":1,"y":"two"}],"expect":{"ok":false,"status":"UnsupportedOperation"}},
{"id":"export: replace with list","op":"replaceValue","args":[["export"],["a","b"]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"export: replace with nested","op":"replaceValue","args":[["export"],{"inner":{"deep":[1,2]}}],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"export: replace with empty-map","op":"replaceValue","args":[["export"],{}],"expect":{"ok":true,"splice":[23,24,""]}},
{"id":"export: replace with empty-list","op":"replaceValue","args":[["export"],[]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"export: add leading comment","op":"addLeadingComment","args":[["export"],"added comment"],"expect":{"ok":true,"splice":[0,0,"# added comment\n"]}},
{"id":"export: set trailing comment","op":"setTrailingComment","args":[["export"],"added comment"],"expect":{"ok":true,"splice":[24,24," # added comment"]}}
]}
