{"id":"A: add leading comment","op":"addLeadingComment","args":[["A"],"added comment"],"expect":{"ok":false,"status":"ParseError"}},
{"id":"A: set trailing comment","op":"setTrailingComment","args":[["A"],"added comment"],"expect":{"ok":true,"splice":[0,6,"A=1 # added comment"]}}
