{"id":"root: insert negative","op":"insertValue","args":[[],"added_negative",-7],"expect":{"ok":true,"splice":[0,6,"A=1\nadded_negative=-7"]}},
{"id":"root: insert float","op":"insertValue","args":[[],"added_float",2.5],"expect":{"ok":true,"splice":[0,6,"A=1\nadded_float=2.5"]}},
{"id":"root: insert bool","op":"insertValue","args":[[],"added_bool",true],"expect":{"ok":true,"splice":[0,6,"A=1\nadded_bool=true"]}},
{"id":"root: insert word","op":"insertValue","args":[[],"added_word","word"],"expect":{"ok":true,"splice":[0,6,"A=1\nadded_word=word"]}},
{"id":"root: insert map","op":"insertValue","args":[[],"added_map",{"x":1,"y":"two"}],"expect":{"ok":false,"status":"ParseError"}},
{"id":"root: insert list","op":"insertValue","args":[[],"added_list",["a","b"]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: insert nested","op":"insertValue","args":[[],"added_nested",{"inner":{"deep":[1,2]}}],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: insert empty-map","op":"insertValue","args":[[],"added_empty-map",{}],"expect":{"ok":false,"status":"ParseError"}},
{"id":"root: insert empty-list","op":"insertValue","args":[[],"added_empty-list",[]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"root: set new key","op":"setValue","args":[["set_key"],"set"],"expect":{"ok":true,"splice":[0,6,"A=1\nset_key=set"]}},
{"id":"root: set existing key","op":"setValue","args":[["A"],"set"],"expect":{"ok":true,"splice":[0,6,"A=set"]}},
{"id":"root: add dangling comment","op":"addDanglingComment","args":[[],"added comment"],"expect":{"ok":true,"splice":[0,6,"A=1\n# added comment"]}},
{"id":"A: rename","op":"renameKey","args":[["A"],"renamed"],"expect":{"ok":true,"splice":[0,4,"renamed"]}},
{"id":"A: delete","op":"deleteKey","args":[["A"]],"expect":{"ok":true,"splice":[0,7,""]}},
{"id":"A: replace with int","op":"replaceValue","args":[["A"],42],"expect":{"ok":true,"splice":[0,6,"A=42"]}},
{"id":"A: replace with negative","op":"replaceValue","args":[["A"],-7],"expect":{"ok":true,"splice":[0,6,"A=-7"]}},
{"id":"A: replace with float","op":"replaceValue","args":[["A"],2.5],"expect":{"ok":true,"splice":[0,6,"A=2.5"]}},
{"id":"A: replace with bool","op":"replaceValue","args":[["A"],true],"expect":{"ok":true,"splice":[0,6,"A=true"]}},
{"id":"A: replace with word","op":"replaceValue","args":[["A"],"word"],"expect":{"ok":true,"splice":[0,6,"A=word"]}},
{"id":"A: replace with spaced","op":"replaceValue","args":[["A"],"two words"],"expect":{"ok":true,"splice":[0,6,"A=two words"]}},
{"id":"A: replace with punctuated","op":"replaceValue","args":[["A"],"a: b # c, [d] {e} \"f\" 'g'"],"expect":{"ok":true,"splice":[0,6,"A=\"a: b # c, [d] {e} \\\"f\\\" 'g'\""]}},
{"id":"A: replace with multiline","op":"replaceValue","args":[["A"],"line one\nline two"],"expect":{"ok":true,"splice":[0,6,"A=\"line one\\nline two\""]}},
{"id":"A: replace with empty","op":"replaceValue","args":[["A"],""],"expect":{"ok":true,"splice":[0,6,"A="]}},
{"id":"A: replace with map","op":"replaceValue","args":[["A"],{"x":1,"y":"two"}],"expect":{"ok":true,"splice":[0,6,"A=x=1\ny=two"]}},
{"id":"A: replace with list","op":"replaceValue","args":[["A"],["a","b"]],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"A: replace with nested","op":"replaceValue","args":[["A"],{"inner":{"deep":[1,2]}}],"expect":{"ok":false,"status":"UnsupportedFormat"}},
{"id":"A: replace with empty-map","op":"replaceValue","args":[["A"],{}],"expect":{"ok":true,"splice":[0,6,"A="]}},
