{
  "name": "fig-conformance",
  "private": true,
  "description": "Conformance suites for configuration languages, for any parser or editor: JSON, YAML, TOML, JSON5, ZON, INI, dotenv, plist and more",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "parse": "node --conditions=fig-source runner/parse.mjs",
    "parse:compiled": "node --conditions=fig-source --import ./lib/reference-wasm.mjs runner/parse.mjs",
    "edits": "node --conditions=fig-source runner/edits.mjs",
    "record:edits": "node --conditions=fig-source --import ./lib/reference-wasm.mjs scripts/record-edits.mjs",
    "parse:native": "node --conditions=fig-source runner/parse.mjs --languages ../fig/languages",
    "edits:native": "node --conditions=fig-source runner/edits.mjs --languages ../fig/languages"
  }
}
